# 环境变量示例：复制为 .env 并填入真实值，.env 不要提交到 git！
# DB_DRIVER = mysql            # sqlite（本地调试） / mysql（生产）
# MYSQL_HOST = 你的数据库地址
# MYSQL_USER = 数据库用户名
# MYSQL_PASSWORD = 数据库密码
# MYSQL_DB = petcare
# WX_APPID = 你的小程序 AppID（mp.weixin.qq.com → 开发管理 → 开发设置）
# WX_SECRET = 你的 AppSecret（仅存服务器，绝不进前端）
# TEMPLATE_ID = 订阅消息模板 ID
# TOKEN_SECRET = 随机长字符串（终端执行 python -c "import secrets;print(secrets.token_hex(32))" 生成）
