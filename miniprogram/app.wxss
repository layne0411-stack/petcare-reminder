/* ============================================================
   崽崽打卡站 · 全局样式（奶油马卡龙设计系统）
   色板：奶油白底 / 蜜桃橙主色 / 薄荷绿 / 黄油黄 / 珊瑚红点缀
   ============================================================ */
page {
  /* 主色系 */
  --peach: #FF9A62;          /* 主色·蜜桃橙 */
  --peach-deep: #F07B3F;     /* 主色·深 */
  --peach-bg: #FFEFE3;       /* 主色浅底 */
  --mint: #3FA796;           /* 薄荷·深（文字用） */
  --mint-bg: #E2F6EF;        /* 薄荷浅底 */
  --butter: #E8A93D;         /* 黄油·深（文字用） */
  --butter-bg: #FFF3D6;      /* 黄油浅底 */
  --coral: #E8604C;          /* 珊瑚红（逾期/危险） */
  --coral-bg: #FDE9E4;       /* 珊瑚浅底 */
  --lavender-bg: #EFE9FB;    /* 淡紫浅底 */
  --lavender: #8B77C9;

  /* 中性色（暖调） */
  --bg: #FFF6EC;             /* 页面底·奶油白 */
  --card: #FFFFFF;
  --ink: #5C4A3D;            /* 正文·可可棕 */
  --ink-light: #B09C8C;      /* 次要文字·暖灰棕 */
  --line: #F4E8DB;

  /* 圆角与阴影（大圆角 + 奶油色柔和投影） */
  --radius: 28rpx;
  --radius-lg: 40rpx;
  --shadow: 0 10rpx 28rpx rgba(214, 158, 106, 0.16);
  --shadow-soft: 0 6rpx 18rpx rgba(214, 158, 106, 0.12);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  background-color: var(--bg);
  box-sizing: border-box;
}

view, text, image, input, picker, button, textarea {
  box-sizing: border-box;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 0 28rpx 26rpx;
  box-shadow: var(--shadow-soft);
}

/* ---------- 主按钮（大圆角胶囊） ---------- */
.btn-primary {
  background: linear-gradient(135deg, #FFB088, var(--peach));
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(255, 154, 98, 0.38);
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); }

/* ---------- 胶囊徽章 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  line-height: 1.4;
}
.pill-coral  { background: var(--coral-bg);  color: var(--coral); }
.pill-peach  { background: var(--peach-bg);  color: var(--peach-deep); }
.pill-mint   { background: var(--mint-bg);   color: var(--mint); }
.pill-butter { background: var(--butter-bg); color: var(--butter); }
.pill-gray   { background: #F5EFE7; color: var(--ink-light); }

/* ---------- 安全区 ---------- */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 通用弹框（奶油风，替代系统 showModal） ---------- */
.cm-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9990;
  background: rgba(92, 74, 61, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 70rpx;
  animation: cm-fade 0.18s ease-out;
}
.cm-box {
  width: 100%;
  max-width: 560rpx;
  background: linear-gradient(170deg, #FFFDFA 0%, #FFF8F0 100%);
  border-radius: 44rpx;
  padding: 44rpx 40rpx 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(163, 116, 74, 0.22);
  animation: cm-pop 0.24s cubic-bezier(0.32, 1.4, 0.6, 1);
  text-align: center;
}
@keyframes cm-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes cm-pop {
  from { opacity: 0; transform: scale(0.86) translateY(20rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.cm-emoji {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #FFF0E2, #FFE1CB);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(255, 154, 98, 0.22);
}
.cm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
}
.cm-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-light);
  white-space: pre-wrap;
  max-height: 620rpx;
  overflow-y: auto;
}
.cm-input {
  margin-top: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  background: #FBF4EA;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  text-align: left;
}
.cm-placeholder { color: #CBB9A9; }

.cm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}
.cm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 29rpx;
  font-weight: 700;
  transition: transform 0.12s;
}
.cm-btn:active { transform: scale(0.96); }
.cm-cancel {
  background: #F6EFE6;
  color: var(--ink-light);
}
.cm-confirm {
  background: linear-gradient(135deg, #FFB088, var(--peach));
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 154, 98, 0.32);
}
.cm-confirm-danger {
  background: linear-gradient(135deg, #F58A75, var(--coral));
  box-shadow: 0 8rpx 20rpx rgba(232, 96, 76, 0.28);
}

/* ---------- 弹框内的日期选择行 ---------- */
.cm-field {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #FBF4EA;
  border-radius: 20rpx;
  padding: 0 26rpx;
  height: 88rpx;
}
.cm-field-label {
  font-size: 26rpx;
  color: var(--ink-light);
  flex-shrink: 0;
}
.cm-field-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: right;
}
