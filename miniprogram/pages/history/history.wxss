.page { padding: 16rpx 0 40rpx; }

.page-tip {
  margin: 8rpx 42rpx 22rpx;
  font-size: 26rpx;
  color: var(--ink-light);
}

/* ---------- 宠物筛选条（与首页一致） ---------- */
.pet-filter {
  white-space: nowrap;
  padding: 0 28rpx 22rpx;
  display: flex;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: var(--ink-light);
  font-size: 25rpx;
  box-shadow: var(--shadow-soft);
  transition: all 0.15s;
}
.filter-chip:active { transform: scale(0.95); }
.filter-active {
  background: linear-gradient(135deg, #FFB088, var(--peach));
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(255, 154, 98, 0.32);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 60rpx;
}
.empty-pet { font-size: 110rpx; transform: rotate(-4deg); }
.empty-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.empty-text { margin-top: 12rpx; color: var(--ink-light); font-size: 27rpx; }

.record-card {
  display: flex;
  align-items: center;
}
.record-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 22rpx;
}
.theme-peach    { background: var(--peach-bg); }
.theme-mint     { background: var(--mint-bg); }
.theme-butter   { background: var(--butter-bg); }
.theme-lavender { background: var(--lavender-bg); }

.record-left { flex: 1; min-width: 0; margin-right: 20rpx; }
.record-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.record-note {
  font-size: 24rpx;
  color: var(--ink-light);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-date { flex-shrink: 0; text-align: right; }
.date-day { font-size: 25rpx; font-weight: 600; color: var(--peach-deep); }
.date-tag {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 20rpx;
  color: var(--mint);
  background: var(--mint-bg);
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
}

/* ---------- 类型筛选 ---------- */
.type-filter {
  display: flex;
  white-space: nowrap;
  padding: 0 28rpx 4rpx;
  margin-bottom: 18rpx;
}
.type-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-light);
  background: #FBF4EA;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
}
.type-active {
  color: var(--peach-deep);
  font-weight: 700;
  background: var(--peach-bg);
  box-shadow: inset 0 0 0 2rpx rgba(255, 154, 98, 0.4);
}

/* ---------- 记录上的小操作 ---------- */
.record-ops {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.op-btn {
  font-size: 22rpx;
  color: var(--ink-light);
  background: #F7F1E9;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}
.op-btn:active { transform: scale(0.94); }
.op-danger { color: var(--coral); background: var(--coral-bg); }
