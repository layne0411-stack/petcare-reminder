.page { padding: 16rpx 0 40rpx; }

.page-tip {
  margin: 8rpx 42rpx 22rpx;
  font-size: 26rpx;
  color: var(--ink-light);
}

/* ---------- 顶部统计条 ---------- */
.stat-bar {
  display: flex;
  align-items: center;
  margin: 0 28rpx 22rpx;
  padding: 28rpx 0;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}
.sb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sb-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--peach-deep);
  line-height: 1.1;
}
.sb-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-light);
}
.sb-divider {
  width: 2rpx;
  height: 52rpx;
  background: var(--line);
}

/* ---------- 双筛选白卡 ---------- */
.filter-card { padding: 20rpx 24rpx; }
.filter-line {
  display: flex;
  align-items: flex-start;
}
.filter-line + .filter-line {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.fl-label {
  flex-shrink: 0;
  width: 108rpx;
  padding-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-light);
}
.fl-chips {
  flex: 1;
  white-space: nowrap;
  display: flex;
  align-items: flex-start;   /* 防御：避免子元素被 stretch 拉满容器高度 */
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #FBF4EA;
  color: var(--ink-light);
  font-size: 24rpx;
  transition: all 0.15s;
}
.filter-chip:active { transform: scale(0.95); }
.filter-active {
  background: linear-gradient(135deg, #FFB088, var(--peach));
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(255, 154, 98, 0.3);
}

.type-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  align-self: flex-start;
  font-size: 24rpx;
  color: var(--ink-light);
  background: #FBF4EA;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
}
.type-active {
  color: var(--peach-deep);
  font-weight: 700;
  background: var(--peach-bg);
  box-shadow: inset 0 0 0 2rpx rgba(255, 154, 98, 0.4);
}

/* ---------- 空状态 ---------- */
.empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 130rpx 60rpx;
  overflow: hidden;
}
.paw-wm {
  position: absolute;
  left: 50%;
  bottom: 26rpx;
  transform: translateX(-50%) rotate(-14deg);
  font-size: 110rpx;
  opacity: 0.08;
  pointer-events: none;
}
.empty-pet { font-size: 110rpx; transform: rotate(-4deg); }
.empty-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.empty-text { margin-top: 12rpx; color: var(--ink-light); font-size: 27rpx; }

/* ---------- 时间轴 ---------- */
.tl-group {
  position: relative;
  margin: 0 28rpx 30rpx;
  padding-left: 40rpx;
}
/* 左侧奶油色竖线 */
.tl-group::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 18rpx;
  bottom: -14rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--line);
}
.tl-group:last-child::before { bottom: 40rpx; }

.tl-date-row {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
/* 日期圆点（普通橙 / 今天绿） */
.tl-dot {
  position: absolute;
  left: -34rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--peach);
  border: 5rpx solid #FFF6EC;
  box-sizing: content-box;
  box-shadow: 0 3rpx 8rpx rgba(255, 154, 98, 0.4);
}
.tl-dot-today { background: var(--mint); box-shadow: 0 3rpx 8rpx rgba(63, 167, 150, 0.4); }
.tl-date {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.tl-card {
  margin: 0 0 18rpx;
  padding: 24rpx 24rpx 22rpx;
}

/* ---------- 记录卡内容 ---------- */
.record-card {
  display: flex;
  align-items: center;
}
.record-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 22rpx;
}
.theme-peach    { background: var(--peach-bg); }
.theme-mint     { background: var(--mint-bg); }
.theme-butter   { background: var(--butter-bg); }
.theme-lavender { background: var(--lavender-bg); }

.record-left { flex: 1; min-width: 0; margin-right: 20rpx; }
.record-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.record-note {
  font-size: 24rpx;
  color: var(--ink-light);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-date { flex-shrink: 0; text-align: right; }
.date-day { font-size: 25rpx; font-weight: 600; color: var(--peach-deep); }
.date-tag {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 20rpx;
  color: var(--mint);
  background: var(--mint-bg);
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
}
.date-tag-weight { color: var(--lavender); background: var(--lavender-bg); }

/* ---------- 记录上的小操作 ---------- */
.record-ops {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.op-btn {
  font-size: 22rpx;
  color: var(--ink-light);
  background: #F7F1E9;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}
.op-btn:active { transform: scale(0.94); }
.op-danger { color: var(--coral); background: var(--coral-bg); }
