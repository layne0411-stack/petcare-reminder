.page {
  padding: 16rpx 0 200rpx;
}

.page-tip {
  margin: 8rpx 42rpx 22rpx;
  font-size: 26rpx;
  color: var(--ink-light);
}

.label {
  font-size: 26rpx;
  color: var(--ink-light);
  margin-bottom: 20rpx;
  font-weight: 600;
}

.input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  background: #FBF4EA;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

/* ---------- 选项 chips ---------- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  background: #F8F0E6;
  color: var(--ink);
  font-size: 26rpx;
  transition: all 0.15s;
}
.chip:active { transform: scale(0.95); }
.chip-active {
  background: var(--peach-bg);
  color: var(--peach-deep);
  font-weight: 700;
  box-shadow: inset 0 0 0 3rpx rgba(255, 154, 98, 0.45);
}
.chip-emoji { margin-right: 8rpx; }

/* ---------- 头像选择 ---------- */
.avatar-preview {
  width: 148rpx;
  height: 148rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #FFF1E4, #FFE3D0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 76rpx;
  line-height: 1;
  box-shadow: var(--shadow-soft);
}
.avatar-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
}
.avatar-item {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: #FBF4EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: all 0.15s;
}
.avatar-item:active { transform: scale(0.92); }
.avatar-active {
  background: var(--peach-bg);
  transform: scale(1.06);
  box-shadow: inset 0 0 0 4rpx rgba(255, 154, 98, 0.5);
}

.picker-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  background: #FBF4EA;
  border-radius: 20rpx;
}

/* ---------- 删除 ---------- */
.danger-zone {
  margin: 10rpx 0 30rpx;
  text-align: center;
}
.danger-link {
  font-size: 25rpx;
  color: var(--coral);
  padding: 16rpx 24rpx;
}

/* ---------- 底部保存 ---------- */
.save-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 22rpx 28rpx;
  background: linear-gradient(transparent, var(--bg) 45%);
}
