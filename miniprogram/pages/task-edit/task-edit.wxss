.page {
  padding: 16rpx 0 140rpx;
}

.page-tip {
  margin: 8rpx 42rpx 22rpx;
  font-size: 26rpx;
  color: var(--ink-light);
}

.label {
  font-size: 26rpx;
  color: var(--ink-light);
  margin-bottom: 20rpx;
  font-weight: 600;
}
.label.no-margin { margin-bottom: 8rpx; }

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.preset-chip {
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  background: #F8F0E6;
  color: var(--ink);
  font-size: 26rpx;
  transition: all 0.15s;
}
.preset-chip:active { transform: scale(0.95); }
.preset-active {
  background: var(--peach-bg);
  color: var(--peach-deep);
  font-weight: 700;
  box-shadow: inset 0 0 0 3rpx rgba(255, 154, 98, 0.45);
}
.chip-emoji { margin-right: 8rpx; }

.input {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  background: #FBF4EA;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.pet-empty {
  padding: 22rpx 26rpx;
  background: #FBF4EA;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
}
.pet-empty-text {
  font-size: 24rpx;
  color: var(--ink-light);
}
.pet-empty-link {
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--peach-deep);
}

.interval-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.interval-input {
  width: 160rpx;
  margin-top: 0;
  text-align: center;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  background: #FBF4EA;
  border-radius: 20rpx;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hint {
  font-size: 22rpx;
  color: var(--ink-light);
  margin-top: 6rpx;
}

.save-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 22rpx 28rpx;
  background: linear-gradient(transparent, var(--bg) 45%);
}

/* 提醒设置里的间距 */
.gap-top { margin-top: 30rpx; }
.gap-top-sm { margin-top: 14rpx; }
