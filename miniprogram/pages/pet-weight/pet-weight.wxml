<import src="../../templates/modal.wxml" />
<view class="page">
  <!-- 概要 -->
  <view class="hero">
    <view class="hero-avatar">
      <image wx:if="{{petAvatarImg}}" class="hero-avatar-img" src="{{petAvatarImg}}" mode="aspectFill" />
      <text wx:else>{{petAvatar}}</text>
    </view>
    <view class="hero-info">
      <view class="hero-name">{{petName}}</view>
      <view class="hero-weight" wx:if="{{latest}}">
        <text class="weight-num">{{latest.weight}}</text>
        <text class="weight-unit">kg</text>
        <text class="weight-change {{changeClass}}" wx:if="{{changeText}}">{{changeText}}</text>
      </view>
      <view class="hero-empty" wx:else>还没有记录，先记第一次吧</view>
      <view class="hero-date" wx:if="{{latest}}">最近一次 · {{latest.date}}</view>
    </view>
  </view>

  <!-- 趋势 -->
  <view class="card" wx:if="{{bars.length}}">
    <view class="label">📈 最近 {{bars.length}} 次</view>
    <view class="chart">
      <view class="bar-col" wx:for="{{bars}}" wx:key="label">
        <view class="bar-value">{{item.value}}</view>
        <view class="bar-track">
          <view class="bar-fill" style="height: {{item.h}}%"></view>
        </view>
        <view class="bar-label">{{item.label}}</view>
      </view>
    </view>
    <view class="chart-tip">仅记录数据，不做健康判断；体重异常请咨询宠物医生</view>
  </view>

  <!-- 新增 -->
  <view class="card">
    <view class="label">记一笔体重</view>
    <view class="input-row">
      <input
        class="input weight-input"
        type="digit"
        placeholder="如 4.2"
        placeholder-class="ph"
        value="{{inputWeight}}"
        bindinput="onWeightInput"
      />
      <text class="unit">kg</text>
      <picker mode="date" value="{{inputDate}}" end="{{today}}" bindchange="onDateChange">
        <view class="date-pick">{{inputDate}} ▾</view>
      </picker>
    </view>
    <button class="btn-primary save-btn" bindtap="onSave" loading="{{saving}}">保存记录</button>
  </view>

  <!-- 历史 -->
  <view class="card" wx:if="{{weights.length}}">
    <view class="label">全部记录</view>
    <view class="w-item" wx:for="{{weights}}" wx:key="id">
      <text class="w-date">{{item.date}}</text>
      <text class="w-value">{{item.weight}} kg</text>
      <text class="w-del" catchtap="onDelete" data-id="{{item.id}}">✕</text>
    </view>
  </view>

  <view wx:if="{{!loading && !weights.length}}" class="empty">
    <text class="empty-emoji">⚖️</text>
    <text class="empty-title">还没有体重数据</text>
    <text class="empty-text">定期称重能看出长胖还是掉秤，对老年宠尤其有用</text>
  </view>

  <template is="cute-modal" data="{{modal: modal}}" />
</view>
