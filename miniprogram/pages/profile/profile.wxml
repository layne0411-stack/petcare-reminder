<import src="../../templates/modal.wxml" />
<view class="page">
  <!-- 用户身份卡 -->
  <view class="profile-card">
    <view class="deco-c1"></view>
    <view class="deco-c2"></view>

    <view class="avatar-box">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseWechatAvatar">
        <view class="avatar-wrap">
          <image
            wx:if="{{isImageAvatar}}"
            class="avatar-img"
            src="{{avatarImg}}"
            mode="aspectFill"
            binderror="onAvatarError"
          />
          <text wx:else class="avatar-emoji">{{avatar}}</text>
        </view>
      </button>
      <!-- 相机角标：view 兄弟节点（微信 button 在真机上无法稳定重置样式，两次拉宽崩坏，
           故不再用 button 承载角标）。点击走 wx.chooseMedia 选图上传，点头像则走微信头像快捷选择 -->
      <view class="avatar-badge" catchtap="onPickAlbum">📷</view>
    </view>

    <view class="nick-row" bindtap="onEditNickname">
      <text class="nickname">{{nickname}}</text>
      <text class="edit-hint">✏️</text>
    </view>

    <view class="join-line">✅ 微信登录<block wx:if="{{joinedAt}}"> · 加入于 {{joinedAt}}</block></view>
  </view>

  <!-- emoji 头像选择 -->
  <view class="card">
    <view class="label">换个可爱头像</view>
    <view class="emoji-list">
      <view
        wx:for="{{emojis}}"
        wx:key="*this"
        class="emoji-item {{avatar === item ? 'emoji-active' : ''}}"
        bindtap="onPickEmoji"
        data-emoji="{{item}}"
      >{{item}}</view>
    </view>
    <view class="hint">点上方大头像可换成你的微信头像</view>
  </view>

  <!-- 使用统计 -->
  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-num">{{petCount}}</text>
      <text class="stat-label">崽崽</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{taskCount}}</text>
      <text class="stat-label">护理任务</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{recordCount}}</text>
      <text class="stat-label">完成打卡</text>
    </view>
  </view>

  <!-- 体重迷你趋势（第一只宠物的最近 5 次） -->
  <view class="card weight-card" wx:if="{{weightTrend}}" bindtap="goWeightPage">
    <view class="weight-head">
      <text class="weight-title">{{weightTrend.petAvatar}} {{weightTrend.petName}}的体重趋势</text>
      <text class="weight-latest">{{weightTrend.latest}} kg<text class="weight-diff {{weightTrend.diff >= 0 ? 'diff-up' : 'diff-down'}}">{{weightTrend.diff >= 0 ? '▲' : '▼'}} {{weightTrend.diff >= 0 ? weightTrend.diff : -weightTrend.diff}}</text></text>
    </view>
    <view class="weight-bars">
      <view class="wb-item" wx:for="{{weightTrend.bars}}" wx:key="date">
        <view class="wb-bar" style="height: {{item.h}}rpx;"></view>
        <text class="wb-val">{{item.value}}</text>
        <text class="wb-date">{{item.date}}</text>
      </view>
    </view>
    <view class="weight-more">全部记录 ›</view>
  </view>

  <!-- 提醒配额（圆环可视化剩余量） -->
  <view class="card remind-card">
    <view class="remind-row">
      <view class="quota-ring" style="background: {{ringStyle}};">
        <view class="quota-hole">
          <text class="quota-num">{{quotaLeft}}</text>
          <text class="quota-unit">条</text>
        </view>
      </view>
      <view class="remind-left">
        <view class="remind-title">🔔 可发送提醒</view>
        <view class="remind-sub">一次性订阅，每次授权可发 1 条</view>
      </view>
      <view class="renew-btn" bindtap="onRenewQuota">续订 +1</view>
    </view>
    <view class="remind-log" bindtap="onRemindLogs">查看发送记录 ›</view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="onRemindHelp">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">订阅提醒说明</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onPrivacy">
      <text class="menu-icon">🛡️</text>
      <text class="menu-text">隐私保护指引</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-icon">🐾</text>
      <text class="menu-text">关于崽崽打卡站</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <template is="cute-modal" data="{{modal: modal}}" />
</view>
